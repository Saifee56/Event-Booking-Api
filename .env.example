# ---- Django ----
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Postgres ----
POSTGRES_DB=ticketdb
POSTGRES_USER=ticket_app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ---- Redis (not used yet) ----
REDIS_URL=redis://redis:6379/0
# ---- JWT / Auth ----
# Leave JWT_SIGNING_KEY empty to fall back to DJANGO_SECRET_KEY
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
AUTH_LOGIN_THROTTLE_RATE=5/min
AUTH_REGISTER_THROTTLE_RATE=5/min

# ---- HTTPS (set True only once nginx serves TLS) ----
DJANGO_SECURE_HTTPS=False
DJANGO_HSTS_SECONDS=3600
